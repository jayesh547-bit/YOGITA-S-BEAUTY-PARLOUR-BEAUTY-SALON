# ==============================================================================
# YOGITA'S BEAUTY PARLOUR & BEAUTY SALON - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Credentials (Obtain from https://app.supabase.com)
# 1. Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# 2. Project Settings -> API -> Project API keys -> anon/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# 3. Project Settings -> API -> Project API keys -> service_role key (SERVER-SIDE ONLY, NEVER EXPOSE IN FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Admin Authentication Secret (Used for admin session tokens)
ADMIN_JWT_SECRET=super-secure-random-secret-key-change-this-for-production
ADMIN_DEFAULT_EMAIL=admin@yogitasbeauty.com
ADMIN_DEFAULT_PASSWORD=YogitaLuxury@2025

# Salon WhatsApp & Contact Configuration
NEXT_PUBLIC_SALON_WHATSAPP=919876543210
NEXT_PUBLIC_SALON_PHONE=+91 98765 43210
NEXT_PUBLIC_SALON_EMAIL=contact@yogitasbeauty.com

